# Copy to .env and fill in. .env is git-ignored and must never enter the sandbox.

# Production: Vultr Serverless Inference (same model, Vultr's id has no vendor prefix)
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
MODEL=deepseek-v4.1-flash-1017
INFERENCE_API_KEY=

# --- Sandbox ---
SANDBOX_IMAGE=csv-analyst-sandbox:latest
# runc locally (Docker Desktop); runsc (gVisor) on the Vultr VM
SANDBOX_RUNTIME=runc
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128
MAX_REPAIR_ATTEMPTS=3
